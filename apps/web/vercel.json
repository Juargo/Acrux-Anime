{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "buildCommand": "pnpm --filter @acrux/web... build",
  "regions": ["gru1"],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/@:handle",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|facebookcatalog|meta-externalagent|WhatsApp/|Twitterbot|Discordbot|TelegramBot|Slackbot|Slack-ImgProxy|LinkedInBot|Googlebot|Google-InspectionTool|bingbot|YandexBot|Pinterestbot|Applebot|redditbot|Iframely|Embedly|SkypeUriPreview|vkShare|Mastodon/).*"
        }
      ],
      "destination": "/api"
    },
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://app.acruxanime.com"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https://s4.anilist.co https://lh3.googleusercontent.com; font-src 'self'; connect-src 'self' https://s4.anilist.co https://lh3.googleusercontent.com https://ep-round-snow-b5mftgmf.neonauth.c-7.us-east-2.aws.neon.tech https://graphql.anilist.co https://eu.i.posthog.com https://*.ingest.de.sentry.io; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=(), web-share=(self)"
        }
      ]
    }
  ]
}
