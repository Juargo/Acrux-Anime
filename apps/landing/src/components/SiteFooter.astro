---
import type { Locale } from '@acrux/i18n';
import { getCopy } from '../i18n';
import Logo from './Logo.astro';

// Footer shared by the landing and the legal pages (Figma D40/D42).
interface Props {
  locale: Locale;
  // The same page in the other locale. Defaults to the other landing.
  otherHref?: string;
}

const { locale } = Astro.props;
const t = getCopy(locale);
const otherHref = Astro.props.otherHref ?? t.otherLocale.href;
---

<footer class="site-footer">
  <div class="site-footer__inner wrap">
    <div class="site-footer__row">
      <Logo />
      <nav aria-label={t.footer.nav}>
        <ul class="site-footer__links">
          <li><a class="text-button" href={t.footer.privacy.href}>{t.footer.privacy.label}</a></li>
          <li><a class="text-button" href={t.footer.terms.href}>{t.footer.terms.label}</a></li>
          <li><a class="text-button" href={t.footer.support.href}>{t.footer.support.label}</a></li>
          <li><a class="text-button" href={t.footer.deleteAccount.href}>{t.footer.deleteAccount.label}</a></li>
          <li class="site-footer__locale">
            <a class="text-button" href={otherHref} hreflang={t.otherLocale.lang} lang={t.otherLocale.lang}>
              {t.otherLocale.label}
            </a>
          </li>
        </ul>
      </nav>
    </div>
    <p class="site-footer__attribution">{t.footer.attribution}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border-default);
  }

  .site-footer__inner {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
    padding-block: 32px;
  }

  .site-footer__row {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-sm);
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    column-gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* On phones the header already offers the language switch (M40). */
  .site-footer__locale {
    display: none;
  }

  .site-footer__attribution {
    color: var(--color-text-secondary);
    font-size: 12px;
    font-weight: 500;
    line-height: 16px;
  }

  @media (min-width: 1024px) {
    .site-footer__inner {
      padding-block: 40px;
    }

    .site-footer__row {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }

    .site-footer__links {
      column-gap: var(--spacing-sm);
    }

    .site-footer__locale {
      display: list-item;
    }
  }
</style>
