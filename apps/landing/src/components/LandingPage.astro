---
import type { Locale } from '@acrux/i18n';
import { getCopy } from '../i18n';
import Landing from '../layouts/Landing.astro';
import BenefitBlocks from './BenefitBlocks.astro';
import Logo from './Logo.astro';
import ShareCard from './ShareCard.astro';
import WaitlistForm from './WaitlistForm.astro';

// Validation landing (Figma D40 desktop, M40 phone). Issue #14.
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getCopy(locale);
const home = locale === 'es' ? '/' : '/en/';
---

<Landing locale={locale}>
  <header class="site-header wrap">
    <a href={home} aria-label="Acrux"><Logo /></a>
    <a class="text-button" href={t.otherLocale.href} hreflang={t.otherLocale.lang} lang={t.otherLocale.lang}>
      {t.otherLocale.label}
    </a>
  </header>

  <main>
    <section class="hero wrap" aria-labelledby="hero-title">
      <div class="hero__copy">
        <p class="chip">{t.hero.chip}</p>
        <h1 class="hero__title" id="hero-title">{t.hero.title}</h1>
        <p class="hero__lead">{t.hero.lead}</p>
        <WaitlistForm id="hero" t={t.form} privacyHref={t.footer.privacy.href} />
      </div>
      <div class="hero__card">
        <ShareCard t={t.card} />
      </div>
    </section>

    <BenefitBlocks id="how-it-works" title={t.howItWorks.title} lead={t.howItWorks.lead} blocks={t.howItWorks.blocks} />
    <BenefitBlocks id="why-acrux" title={t.whyAcrux.title} blocks={t.whyAcrux.blocks} />

    <section class="final-cta" aria-labelledby="final-cta-title">
      <div class="final-cta__inner wrap">
        <div class="final-cta__text">
          <h2 class="section-title" id="final-cta-title">{t.finalCta.title}</h2>
          <p class="section-lead">{t.finalCta.lead}</p>
        </div>
        <WaitlistForm id="final" t={t.form} privacyHref={t.footer.privacy.href} />
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="site-footer__inner wrap">
      <div class="site-footer__row">
        <Logo />
        <nav aria-label={t.footer.nav}>
          <ul class="site-footer__links">
            <li><a class="text-button" href={t.footer.privacy.href}>{t.footer.privacy.label}</a></li>
            <li><a class="text-button" href={t.footer.support.href}>{t.footer.support.label}</a></li>
            <li><a class="text-button" href={t.footer.deleteAccount.href}>{t.footer.deleteAccount.label}</a></li>
            <li class="site-footer__locale">
              <a class="text-button" href={t.otherLocale.href} hreflang={t.otherLocale.lang} lang={t.otherLocale.lang}>
                {t.otherLocale.label}
              </a>
            </li>
          </ul>
        </nav>
      </div>
      <p class="site-footer__attribution">{t.footer.attribution}</p>
    </div>
  </footer>
</Landing>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 16px;
  }

  .site-header > a:first-child {
    display: inline-flex;
    text-decoration: none;
  }

  .hero {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding-block: 24px 0;
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-lg);
  }

  .chip {
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--color-accent-default);
    color: var(--color-text-on-accent);
    font-size: 14px;
    line-height: 20px;
  }

  .hero__title {
    font-family: var(--font-display);
    font-size: 40px;
    font-weight: 700;
    line-height: 44px;
    letter-spacing: -0.4px;
  }

  .hero__lead {
    color: var(--color-text-secondary);
  }

  .hero__card {
    margin-top: 24px;
  }

  .final-cta {
    background: var(--color-bg-surface);
  }

  .final-cta__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-lg);
    padding-block: 48px;
  }

  .final-cta__text {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    max-width: 560px;
    text-align: center;
  }

  .site-footer {
    border-top: 1px solid var(--color-border-default);
  }

  .site-footer__inner {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
    padding-block: 32px;
  }

  .site-footer__row {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-sm);
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    column-gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* On phones the header already offers the language switch (M40). */
  .site-footer__locale {
    display: none;
  }

  .site-footer__attribution {
    color: var(--color-text-secondary);
    font-size: 12px;
    font-weight: 500;
    line-height: 16px;
  }

  @media (min-width: 1024px) {
    .site-header {
      padding-block: 24px;
    }

    .hero {
      flex-direction: row;
      align-items: center;
      gap: 64px;
      padding-block: 48px 96px;
    }

    .hero__copy {
      flex: none;
      width: 600px;
    }

    .hero__title {
      font-size: 56px;
      line-height: 60px;
      letter-spacing: -0.56px;
    }

    .hero__card {
      flex: 1;
      margin-top: 0;
    }

    .final-cta__inner {
      padding-block: 96px;
    }

    .site-footer__inner {
      padding-block: 40px;
    }

    .site-footer__row {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }

    .site-footer__links {
      column-gap: var(--spacing-sm);
    }

    .site-footer__locale {
      display: list-item;
    }
  }
</style>
