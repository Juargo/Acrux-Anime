---
import type { Copy } from '../i18n';

interface Props {
  id: string;
  t: Copy['form'];
  privacyHref: string;
}

const { id, t, privacyHref } = Astro.props;

// Buttondown embed endpoint (ADR-0033). The username and the form states
// (sending, invalid email, already registered, network error, success) come with #15.
const username = import.meta.env.PUBLIC_BUTTONDOWN_USERNAME;
const action = username
  ? `https://buttondown.com/api/emails/embed-subscribe/${username}`
  : undefined;
---

<form class="waitlist" method="post" action={action}>
  <label class="waitlist__label" for={`${id}-email`}>{t.label}</label>
  <input
    class="waitlist__input"
    id={`${id}-email`}
    name="email"
    type="email"
    autocomplete="email"
    placeholder={t.placeholder}
    required
    aria-describedby={`${id}-note`}
  />
  <button class="waitlist__submit" type="submit">{t.submit}</button>
  <p class="waitlist__note" id={`${id}-note`}>
    {t.notePrefix}<a href={privacyHref}>{t.noteLink}</a>
  </p>
</form>

<style>
  .waitlist {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    width: 100%;
    max-width: 440px;
  }

  .waitlist__label {
    font-size: 12px;
    font-weight: 600;
    line-height: 16px;
    letter-spacing: 0.24px;
  }

  .waitlist__input {
    min-height: 48px;
    padding: var(--spacing-sm) var(--spacing-md);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    background: var(--color-bg-surface);
    color: var(--color-text-primary);
    font: inherit;
  }

  .waitlist__input::placeholder {
    color: var(--color-text-secondary);
    opacity: 1;
  }

  .waitlist__submit {
    min-height: 48px;
    padding: 12px 20px;
    border: 0;
    border-radius: var(--radius-md);
    background: var(--color-accent-default);
    color: var(--color-text-on-accent);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .waitlist__submit:hover {
    background: var(--color-text-link);
  }

  .waitlist__note {
    color: var(--color-text-secondary);
    font-size: 12px;
    font-weight: 500;
    line-height: 16px;
  }

  .waitlist__note a {
    color: inherit;
  }
</style>
