{
  "name": "@acrux/e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run --dir scripts",
    "check-tags": "node scripts/check-ca-tags.ts",
    "build:apps": "pnpm --filter @acrux/api build && VITE_NEON_AUTH_URL=http://localhost:4173/neon-auth pnpm --filter @acrux/web build",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "jose": "^6.2.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
