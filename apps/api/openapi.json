{
  "openapi": "3.1.0",
  "info": {
    "title": "Acrux API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://app.acruxanime.com"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Availability check",
        "security": [],
        "tags": [
          "system"
        ],
        "responses": {
          "200": {
            "description": "The API is up",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "ok"
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "summary": "Profile of the signed-in user, created on the first request",
        "security": [
          {
            "session": []
          }
        ],
        "tags": [
          "profile"
        ],
        "responses": {
          "200": {
            "description": "The profile; the email is never returned",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "displayName": {
                      "type": "string"
                    },
                    "avatarUrl": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "locale": {
                      "type": "string"
                    },
                    "listVisibility": {
                      "type": "string",
                      "enum": [
                        "private",
                        "public"
                      ]
                    },
                    "counterMode": {
                      "type": "string",
                      "enum": [
                        "franchise",
                        "entry"
                      ]
                    }
                  },
                  "required": [
                    "displayName",
                    "avatarUrl",
                    "locale",
                    "listVisibility",
                    "counterMode"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "The database is not configured"
          }
        }
      },
      "patch": {
        "summary": "Change the profile of the signed-in user; only the counter mode for now",
        "security": [
          {
            "session": []
          }
        ],
        "tags": [
          "profile"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "counterMode": {
                    "type": "string",
                    "enum": [
                      "franchise",
                      "entry"
                    ]
                  }
                },
                "required": [
                  "counterMode"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The profile after the change",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "displayName": {
                      "type": "string"
                    },
                    "avatarUrl": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "locale": {
                      "type": "string"
                    },
                    "listVisibility": {
                      "type": "string",
                      "enum": [
                        "private",
                        "public"
                      ]
                    },
                    "counterMode": {
                      "type": "string",
                      "enum": [
                        "franchise",
                        "entry"
                      ]
                    }
                  },
                  "required": [
                    "displayName",
                    "avatarUrl",
                    "locale",
                    "listVisibility",
                    "counterMode"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The body is not a known change"
          },
          "401": {
            "description": "Missing, invalid or expired session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "The database is not configured"
          }
        }
      }
    },
    "/api/v1/me/marks": {
      "get": {
        "summary": "Marks of the signed-in user, ordered by anilistId, one page at a time",
        "security": [
          {
            "session": []
          }
        ],
        "tags": [
          "marks"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "description": "The nextCursor of the previous page; leave it out for the first",
              "type": "string",
              "pattern": "^[1-9]\\d*$"
            },
            "description": "The nextCursor of the previous page; leave it out for the first"
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "description": "Marks per page, 1 to 1000; 500 by default",
              "type": "string",
              "pattern": "^[1-9]\\d*$"
            },
            "description": "Marks per page, 1 to 1000; 500 by default"
          }
        ],
        "responses": {
          "200": {
            "description": "One page of marks; nextCursor is null on the last page",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Mark"
                      }
                    },
                    "nextCursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "items",
                    "nextCursor"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The cursor or the limit is not a valid positive integer"
          },
          "401": {
            "description": "Missing, invalid or expired session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "The database is not configured"
          }
        }
      }
    },
    "/api/v1/me/marks/{anilistId}": {
      "put": {
        "summary": "Mark one entry; the same status again keeps markedAt",
        "security": [
          {
            "session": []
          }
        ],
        "tags": [
          "marks"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "anilistId",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "required": true
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "seen",
                      "watching"
                    ]
                  },
                  "malId": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 2147483647
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "status"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The stored mark",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mark"
                }
              }
            }
          },
          "400": {
            "description": "Invalid anilistId, unknown fields or an invalid body"
          },
          "401": {
            "description": "Missing, invalid or expired session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests; retry after the seconds in Retry-After",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "The database is not configured"
          }
        }
      },
      "delete": {
        "summary": "Unmark one entry; also 204 when it was not marked",
        "security": [
          {
            "session": []
          }
        ],
        "tags": [
          "marks"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "anilistId",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "required": true
          }
        ],
        "responses": {
          "204": {
            "description": "Not marked anymore"
          },
          "400": {
            "description": "The anilistId is not a positive integer"
          },
          "401": {
            "description": "Missing, invalid or expired session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests; retry after the seconds in Retry-After",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "The database is not configured"
          }
        }
      }
    },
    "/api/v1/me/marks:batch": {
      "post": {
        "summary": "Mark or unmark 1 to 200 distinct entries in one transaction",
        "security": [
          {
            "session": []
          }
        ],
        "tags": [
          "marks"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "seen",
                          "watching"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "entries": {
                    "minItems": 1,
                    "maxItems": 200,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "anilistId": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 2147483647
                        },
                        "malId": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 2147483647
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": [
                        "anilistId"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "status",
                  "entries"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The marks written; empty when the status is null",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Mark"
                      }
                    }
                  },
                  "required": [
                    "items"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Unknown fields, repeated entries or an invalid body"
          },
          "401": {
            "description": "Missing, invalid or expired session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests; retry after the seconds in Retry-After",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "The database is not configured"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "code": {
            "type": "string",
            "description": "Stable code the web app maps to a message"
          },
          "requestId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "requestId"
        ],
        "additionalProperties": false
      },
      "Mark": {
        "type": "object",
        "properties": {
          "anilistId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "malId": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "seen",
              "watching"
            ]
          },
          "markedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "anilistId",
          "malId",
          "status",
          "markedAt"
        ],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "session": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
