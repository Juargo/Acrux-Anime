{
  "openapi": "3.1.0",
  "info": {
    "title": "Acrux API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://app.acruxanime.com"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Availability check",
        "security": [],
        "tags": [
          "system"
        ],
        "responses": {
          "200": {
            "description": "The API is up",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "ok"
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "summary": "Profile of the signed-in user, created on the first request",
        "security": [
          {
            "session": []
          }
        ],
        "tags": [
          "profile"
        ],
        "responses": {
          "200": {
            "description": "The profile; the email is never returned",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "displayName": {
                      "type": "string"
                    },
                    "avatarUrl": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "locale": {
                      "type": "string"
                    },
                    "listVisibility": {
                      "type": "string",
                      "enum": [
                        "private",
                        "public"
                      ]
                    },
                    "counterMode": {
                      "type": "string",
                      "enum": [
                        "franchise",
                        "entry"
                      ]
                    }
                  },
                  "required": [
                    "displayName",
                    "avatarUrl",
                    "locale",
                    "listVisibility",
                    "counterMode"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "The database is not configured"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "code": {
            "type": "string",
            "description": "Stable code the web app maps to a message"
          },
          "requestId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "requestId"
        ],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "session": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
