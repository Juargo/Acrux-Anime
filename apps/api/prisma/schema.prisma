// Initial model of ADR-0022 (issue #22). The catalog is copied from MyAnimeList into the
// anime table (ADR-0043); the other tables hold only AniList and MAL ids (RDI-13, RDI-20). user_id is the uuid of the Neon Auth user (ADR-0034).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ListVisibility {
  private
  public

  @@map("list_visibility")
}

enum CounterMode {
  franchise
  entry

  @@map("counter_mode")
}

enum MarkStatus {
  seen
  watching

  @@map("mark_status")
}

// Plus is lifetime only (ADR-0036).
enum Plan {
  plus_lifetime

  @@map("plan")
}

enum FranchiseRole {
  core
  extra
  separate

  @@map("franchise_role")
}

// The preset Acrux avatars of Figma M06 (#39); null on the profile means Google's.
// sakura, aurora and eclipse need Plus (RF-55).
enum AvatarPreset {
  violeta
  verde
  amarillo
  coral
  noche
  lavanda
  sakura
  aurora
  eclipse

  @@map("avatar_preset")
}

model Profile {
  userId         String         @id @map("user_id") @db.Uuid
  displayName    String         @map("display_name")
  avatarUrl      String?        @map("avatar_url")
  avatarPreset   AvatarPreset?  @map("avatar_preset")
  // The language the user chose (#43); null follows the browser language.
  locale         String?
  // Private until the user decides to share it (ADR-0028).
  listVisibility ListVisibility @default(private) @map("list_visibility")
  counterMode    CounterMode    @default(franchise) @map("counter_mode")
  // The @handle of the public link (#37), assigned on the profile's first request after it.
  handle         String?        @unique @db.VarChar(20)
  // The owner's last counter, for the public profile and its preview image (#37).
  shownTotal     Int?           @map("shown_total")
  shownMode      CounterMode?   @map("shown_mode")
  // The first card shared, to offer making the list public only then (#36).
  cardSharedAt   DateTime?      @map("card_shared_at") @db.Timestamptz(6)
  // Badge ids earned by milestones (RF-55); the API checks them against its catalog.
  badges         String[]       @default([])
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  marks       Mark[]
  anilistLink AnilistLink?
  entitlement Entitlement?

  @@map("profile")
}

model Mark {
  userId    String     @map("user_id") @db.Uuid
  animeId Int        @map("anime_id")
  malId     Int?       @map("mal_id")
  status    MarkStatus
  // Kept for the yearly summary (Wrapped).
  markedAt  DateTime   @default(now()) @map("marked_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@id([userId, animeId])
  @@map("mark")
}

model AnilistLink {
  userId               String    @id @map("user_id") @db.Uuid
  anilistUserId        Int       @unique @map("anilist_user_id")
  // Encrypted by the API before it is stored (ADR-0025); never plain text.
  accessTokenEncrypted Bytes     @map("access_token_encrypted")
  tokenExpiresAt       DateTime? @map("token_expires_at") @db.Timestamptz(6)
  linkedAt             DateTime  @default(now()) @map("linked_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("anilist_link")
}

model Entitlement {
  userId                 String    @id @map("user_id") @db.Uuid
  plan                   Plan
  // Null for the lifetime plan.
  validUntil             DateTime? @map("valid_until") @db.Timestamptz(6)
  lemonSqueezyCustomerId String?   @map("lemon_squeezy_customer_id")
  // The order that granted Plus, so a refund takes back only that purchase (RF-56).
  lemonSqueezyOrderId    String?   @unique @map("lemon_squeezy_order_id")
  purchasedAt            DateTime? @map("purchased_at") @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("entitlement")
}

// Webhook events already processed, so a webhook is never applied twice. Lemon Squeezy
// sends no event id, so the key is "<event name>:<order id>".
model BillingEvent {
  eventId    String   @id @map("event_id")
  eventName  String   @map("event_name")
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  @@map("billing_event")
}

// Curator corrections to the AniList relation graph; only the curator edits them.
model FranchiseOverride {
  animeId       Int           @id @map("anime_id")
  franchiseRootId Int           @map("franchise_root_id")
  role            FranchiseRole
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("franchise_override")
}

// The catalog copied from MyAnimeList (ADR-0043); the id is MyAnimeList's.
model Anime {
  id              Int       @id
  title           String
  titleEnglish    String?   @map("title_english")
  titleJapanese   String?   @map("title_japanese")
  // Every name of the anime in lower case, for the search by name.
  searchText      String    @map("search_text")
  coverUrl        String?   @map("cover_url")
  // TV, MOVIE, OVA, ONA, SPECIAL or MUSIC.
  format          String?
  // A partial date is stored as its first day.
  startDate       DateTime? @map("start_date") @db.Date
  year            Int?
  episodes        Int?
  durationMinutes Int?      @map("duration_minutes")
  genres          String[]  @default([])
  // Users with the anime in their list at the source: the popularity order.
  members         Int       @default(0)
  // Never served (RF-11).
  adult           Boolean   @default(false)
  // [{ type, id }] with the relation names of @acrux/domain.
  relations       Json      @default("[]")
  // When the detail, relations included, was last read; null while only the list fields are known.
  detailedAt      DateTime? @map("detailed_at") @db.Timestamptz(6)
  fetchedAt       DateTime  @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@index([members(sort: Desc), id])
  @@index([year])
  @@map("anime")
}
