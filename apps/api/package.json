{
  "name": "@acrux/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/app.ts",
      "default": "./dist/app.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc --noEmit -p .",
    "test": "prisma generate && vitest run",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "catalog:load": "prisma generate && tsx scripts/load-catalog.ts",
    "openapi:emit": "prisma generate && tsx scripts/emit-openapi.ts",
    "openapi:check": "prisma generate && tsx scripts/emit-openapi.ts --check",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/node": "^11.9.0",
    "@upstash/redis": "^1.40.0",
    "express": "^5.3.0",
    "jose": "^6.2.13",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "satori": "^0.63.2",
    "zod": "^4.6.7",
    "zod-openapi": "^6.0.2"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "dependency-cruiser": "^18.7.0",
    "prisma": "7.10.1",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
